    function stepWhatsApp() {
      if (state.simChatStep < 3) {
        state.simChatStep++;
        playPing();
      } else {
        state.simChatStep = 0;
      }
      renderScenario();
    }

    function triggerTabletCrack() {
      state.simTabletCracked = !state.simTabletCracked;
      if (state.simTabletCracked) playCrack();
      renderScenario();
      if (state.simTabletCracked) {
        const box = document.getElementById('tablet-box');
        if (box) box.classList.add('animate-shake');
      }
    }

    function scanBrownie() {
      state.simBrownieScanned = !state.simBrownieScanned;
      playPing();
      renderScenario();
    }

    // ==========================================
    // 7. SÉLECTION, PRESSION (10s) & RÉVÉLATION
    // ==========================================
    function selectChoice(idx) {
      clearTimer();
      state.selectedChoice = idx;
      state.revealed = false;
      state.timerSeconds = 10;
      playTick();
      renderScenario();
    }

    function startPressureTimer() {
      clearTimer();
      state.timerSeconds = 10;
      playTick(true);
      renderScenario();
      state.timerInterval = setInterval(() => {
        state.timerSeconds--;
        if (state.timerSeconds > 0) {
          playTick(state.timerSeconds <= 3);
          const timerEl = document.getElementById('countdown-number');
          if (timerEl) timerEl.textContent = `${state.timerSeconds}s`;
        } else {
          clearTimer();
          const timerEl = document.getElementById('countdown-number');
          if (timerEl) timerEl.textContent = "TEMPS ÉCOULÉ !";
        }
      }, 1000);
    }

    function clearTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
    }

    function revealImpact() {
      if (state.selectedChoice === null || state.revealed) return;
      clearTimer();
      const scenario = SCENARIOS[state.currentTab];
      const choice = scenario.choices[state.selectedChoice];

      // Mise à jour des jauges de l'équipe active
      const team = state.teams[state.activeTeam];
      team.soc = clamp(team.soc + choice.soc);
      team.god = clamp(team.god + choice.god);

      state.revealed = true;
      playRevealSound(choice.god);
      updateGaugesUI(choice.soc, choice.god);
      renderScenario();
    }

    function toggleShowAllChoices() {
      state.showAllChoices = !state.showAllChoices;
      renderScenario();
    }

    function executePlotTwist() {
      state.twistExecuted = true;
      state.teams.forEach(t => { t.soc = 0; });
      playDrainSound();
      updateGaugesUI(-100, 0);
      renderScenario();
    }

