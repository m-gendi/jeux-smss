                  <span class="text-xs font-bold text-amber-400 uppercase">1. Les 3 Jeunes Gens</span>
                  <p class="font-bold text-sm text-white mt-1">« Se taire devant le mal, c'est déjà choisir un camp. »</p>
                  <p class="text-xs text-slate-400 mt-1">Un poisson mort suit le courant. Un chrétien vivant nage à contre-courant.</p>
                </div>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span class="text-xs font-bold text-amber-400 uppercase">2. Joseph en Égypte</span>
                  <p class="font-bold text-sm text-white mt-1">« Mon identité, c'est qui je suis quand la vérité me coûte. »</p>
                  <p class="text-xs text-slate-400 mt-1">Dieu préfère une punition honnête qu'une tranquillité volée.</p>
                </div>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span class="text-xs font-bold text-amber-400 uppercase">3. Saint Abanoub (12 ans)</span>
                  <p class="font-bold text-sm text-white mt-1">« Dieu n'est pas mon plan B, ma foi n'est pas un secret. »</p>
                  <p class="text-xs text-slate-400 mt-1">Quand tu assumes ta foi avec le sourire, même les autres te respectent.</p>
                </div>
              </div>
            </div>
          </div>
        `;
        return;
      }

      // RENDU D'UN SCÉNARIO (1, 2, 3 ou Bonus)
      const scenario = SCENARIOS[state.currentTab];
      const selectedObj = state.selectedChoice !== null ? scenario.choices[state.selectedChoice] : null;

      container.innerHTML = `
        <div>
          <!-- En-tête du scénario -->
          <div class="border-b border-slate-800 pb-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400">${scenario.subtitle}</span>
              <span class="text-xs text-slate-400">Vote aux 4 coins de la salle</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-white mt-1">${scenario.title}</h2>
            <p class="text-sm text-slate-300 mt-2 leading-relaxed">${scenario.context}</p>
          </div>

          <!-- Simulateur interactif -->
          ${renderSimulator(scenario)}

          <!-- Grille des Choix A, B, C, D -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-4">
            ${scenario.choices.map((c, idx) => {
              const isSelected = state.selectedChoice === idx;
              const showDetails = (state.revealed && isSelected) || state.showAllChoices;
              return `
                <button onclick="selectChoice(${idx})" class="text-left p-4 rounded-xl border-2 transition flex flex-col justify-between ${
                  isSelected
                    ? 'bg-amber-500/15 border-amber-400 shadow-lg shadow-amber-500/10'
                    : 'bg-slate-950/80 border-slate-800 hover:border-slate-700'
                }">
                  <div class="flex items-start gap-3">
                    <span class="w-8 h-8 rounded-lg font-extrabold text-sm flex items-center justify-center shrink-0 ${
                      isSelected ? 'bg-amber-400 text-slate-950' : 'bg-slate-800 text-slate-300'
                    }">${c.letter}</span>
                    <p class="text-xs sm:text-sm text-slate-100 font-medium leading-snug">${c.text}</p>
                  </div>

                  ${showDetails ? `
                    <div class="mt-3 pt-2.5 border-t border-slate-800/80">
                      <div class="flex items-center justify-between text-xs font-extrabold mb-1">
                        <span class="text-amber-300">${c.tag}</span>
                        <div class="flex gap-2">
                          <span class="px-2 py-0.5 rounded bg-sky-500/20 text-sky-300">😎 ${c.soc >= 0 ? '+'+c.soc : c.soc}</span>
                          <span class="px-2 py-0.5 rounded ${c.god >= 0 ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300'}">🔥 ${c.god >= 0 ? '+'+c.god : c.god}</span>
                        </div>
                      </div>
                      <p class="text-xs text-slate-400 leading-relaxed">${c.explanation}</p>
                    </div>
                  ` : ''}
                </button>
              `;
            }).join('')}
          </div>
        </div>

        <!-- BARRE D'ACTION : TEST DE PRESSION (10s) OU RÉVÉLATION -->
        <div class="mt-2">
          ${state.selectedChoice !== null && !state.revealed ? `
            <div class="bg-rose-950/40 border border-rose-500/50 rounded-xl p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-extrabold uppercase tracking-wider text-rose-300">😈 Test de Pression sociale (Choix ${selectedObj.letter})</span>
                <div class="flex items-center gap-2">
                  <button onclick="startPressureTimer()" class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition urgent-timer">
                    ⏱️ Lancer Chrono 10s (<span id="countdown-number">${state.timerSeconds}s</span>)
                  </button>
                  <button onclick="revealImpact()" class="px-4 py-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs transition shadow-lg">
                    ✨ Révéler l'impact sur les Jauges
                  </button>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-rose-100 italic">
                <strong>Argument tentateur à lire aux jeunes :</strong> « ${selectedObj.devilPrompt} Vous avez 10 secondes si vous voulez changer de coin ! »
              </p>
            </div>
          ` : ''}

          ${state.revealed ? `
            <div class="bg-slate-950 border border-amber-500/40 rounded-xl p-4 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="text-lg">☦️</span>
                  <span class="text-xs font-extrabold uppercase tracking-wider text-amber-400">Témoin de notre Église : ${scenario.saint.name}</span>
                </div>
                <button onclick="toggleShowAllChoices()" class="text-xs font-bold text-sky-400 hover:underline">
                  ${state.showAllChoices ? '🙈 Masquer les autres choix' : '👁️ Comparer les points des 4 choix'}
                </button>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">${scenario.saint.story}</p>
              <div class="p-3 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-200 font-extrabold text-xs sm:text-sm text-center">
                ${scenario.lesson}
              </div>
            </div>
          ` : ''}
        </div>
      `;
    }

    // Initialisation au chargement de la page
    window.addEventListener('DOMContentLoaded', () => {
      renderTabs();
      renderScenario();
      updateGaugesUI();
    });
  </script>
</body>
</html>
