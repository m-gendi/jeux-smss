    function switchTab(tabId) {
      clearTimer();
      state.currentTab = tabId;
      state.selectedChoice = null;
      state.revealed = false;
      state.showAllChoices = false;
      renderTabs();
      renderScenario();
      updateGaugesUI();
    }

