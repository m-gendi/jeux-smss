    // ==========================================
    // 4. GESTION DES JAUGES & ÉQUIPES
    // ==========================================
    function clamp(val) {
      return Math.max(0, Math.min(100, val));
    }

    function getStatusText(score, type) {
      if (type === 'soc') {
        if (score === 0) return "Effacée au passage au lycée !";
        if (score >= 75) return "Star de la cour de récré 🔥";
        if (score >= 45) return "Bien intégré au collège";
        return "À contre-courant du groupe";
      } else {
        if (score >= 85) return "Lumière sur le Roc ☦️";
        if (score >= 60) return "Fidèle et courageux";
        if (score >= 40) return "En chemin, parfois hésitant";
        return "Foi cachée sous le lit ⚠️";
      }
    }

    function updateGaugesUI(socDelta = null, godDelta = null) {
      const team = state.teams[state.activeTeam];
      const socBar = document.getElementById('soc-bar');
      const godBar = document.getElementById('god-bar');
      const socScore = document.getElementById('soc-score');
      const godScore = document.getElementById('god-score');
      const socStatus = document.getElementById('soc-status');
      const godStatus = document.getElementById('god-status');
      const badge = document.getElementById('active-team-badge');

      badge.textContent = state.teamMode ? team.name : "Score du Groupe";

      socBar.style.height = `${team.soc}%`;
      godBar.style.height = `${team.god}%`;
      socScore.textContent = team.soc;
      godScore.textContent = team.god;
      socStatus.textContent = getStatusText(team.soc, 'soc');
      godStatus.textContent = getStatusText(team.god, 'god');

      // Affichage des badges Delta (+15 / -20)
      const socDeltaEl = document.getElementById('soc-delta');
      const godDeltaEl = document.getElementById('god-delta');

      if (socDelta !== null) {
        socDeltaEl.classList.remove('hidden');
        socDeltaEl.textContent = socDelta > 0 ? `+${socDelta}` : `${socDelta}`;
        socDeltaEl.className = `absolute top-3 inset-x-0 text-center font-extrabold text-sm z-20 ${socDelta >= 0 ? 'text-sky-300' : 'text-rose-400'}`;
      } else {
        socDeltaEl.classList.add('hidden');
      }

      if (godDelta !== null) {
        godDeltaEl.classList.remove('hidden');
        godDeltaEl.textContent = godDelta > 0 ? `+${godDelta}` : `${godDelta}`;
        godDeltaEl.className = `absolute top-3 inset-x-0 text-center font-extrabold text-sm z-20 ${godDelta >= 0 ? 'text-emerald-300' : 'text-rose-400'}`;
      } else {
        godDeltaEl.classList.add('hidden');
      }

      renderTeamsUI();
    }

    function toggleTeamMode() {
      state.teamMode = !state.teamMode;
      document.getElementById('label-mode-teams').textContent = state.teamMode ? "Mode : 3 Équipes" : "Mode : Groupe Unique";
      document.getElementById('team-selector').classList.toggle('hidden', !state.teamMode);
      document.getElementById('multi-team-summary').classList.toggle('hidden', !state.teamMode);
      updateGaugesUI();
    }

    function selectTeam(index) {
      state.activeTeam = index;
      updateGaugesUI();
    }

    function renderTeamsUI() {
      if (!state.teamMode) return;
      const btnContainer = document.getElementById('team-buttons');
      btnContainer.innerHTML = state.teams.map((t, idx) => `
        <button onclick="selectTeam(${idx})" class="py-2 px-3 rounded-xl font-bold text-xs border transition ${
          state.activeTeam === idx
            ? 'bg-amber-500 text-slate-950 border-amber-400 shadow-lg shadow-amber-500/20'
            : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700'
        }">
          ${t.name}
        </button>
      `).join('');

      const summary = document.getElementById('multi-team-summary');
      summary.innerHTML = state.teams.map((t, idx) => `
